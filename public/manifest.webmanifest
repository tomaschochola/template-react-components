{
  "background_color": "white",
  "description": "React component library template with TypeScript, Webpack, Playwright, and a component workbench.",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "icons": [
    {
      "purpose": "any",
      "sizes": "192x192",
      "src": "/icon-192x192.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "384x384",
      "src": "/icon-384x384.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "512x512",
      "src": "/icon-512x512.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "1024x1024",
      "src": "/icon-1024x1024.png",
      "type": "image/png"
    },
    {
      "purpose": "maskable",
      "sizes": "512x512",
      "src": "/maskable-icon-512x512.png",
      "type": "image/png"
    },
    {
      "purpose": "maskable",
      "sizes": "1024x1024",
      "src": "/maskable-icon-1024x1024.png",
      "type": "image/png"
    }
  ],
  "id": "/",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "name": "tomaschochola/template-react-components",
  "orientation": "any",
  "prefer_related_applications": false,
  "related_applications": [],
  "scope": "/",
  "short_name": "tomaschochola/template-react-components",
  "start_url": "/",
  "theme_color": "white"
}
